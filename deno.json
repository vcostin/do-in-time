{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "deno task check && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true
  }
}
